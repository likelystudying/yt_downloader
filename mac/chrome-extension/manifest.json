{
  "manifest_version": 3,
  "name": "YT Downloader",
  "version": "1.0.0",
  "description": "Download YouTube videos (MP4) and audio (MP3) to your Mac. Uses the YT Downloader helper app.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "contextMenus", "notifications", "storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "YT Downloader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
